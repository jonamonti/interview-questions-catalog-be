PORT=3000
NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_catalog
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_catalog

API_KEY=some-api-key
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 = clients connect directly).
# Set it in production so rate limits see real client addresses.
TRUST_PROXY=0

# Rate limits per client address and window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_AUTH_FAIL_MAX=10
